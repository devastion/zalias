#!/usr/bin/env zsh

zalias-expand-space() {
  emulate -L zsh

  local word="${LBUFFER##*[[:space:]]}"
  local before="${LBUFFER}"
  local keymap="${KEYMAP}" key flag_key='' fallback

  if [[ -n "${word}" ]]; then
    for key in "${word}" "g:${word}"; do
      if ((${+_zalias_expand_on_space[${key}]})); then
        flag_key="${key}"
        break
      fi
    done
  fi

  if [[ -n "${flag_key}" ]] && ((${+widgets[_expand_alias]})); then
    zle _expand_alias
  fi

  if [[ -n "${flag_key}" && "${LBUFFER}" != "${before}" && "${LBUFFER}" == "${before%${word}}"* ]] \
    && ((${+_zalias_no_trailing_space[${flag_key}]})); then
    [[ "${LBUFFER}" == *' ' ]] && LBUFFER="${LBUFFER% }"
  else
    # Fall back to whatever Space did before the plugin bound it.
    [[ "${keymap}" == main ]] && keymap=emacs
    fallback="${_zalias_prev_space[${keymap}]:-self-insert}"
    ((${+widgets[${fallback}]})) || fallback=self-insert
    zle "${fallback}"
  fi
}

zalias-expand-space "$@"
