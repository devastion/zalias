#!/usr/bin/env zsh

# Reads _zalias_descriptions and _zalias_function_descs (both global).
_zalias_cheatsheet() {
  emulate -L zsh
  local key name definition row file cyan='' dim='' reset='' dkey mark
  local -A rec
  local -i width=5
  local -a lines=()

  if [[ ! -t 1 || "${TERM}" == 'dumb' ]]; then
    for key in "${(@ko)_zalias_descriptions}"; do
      mark=''
      mark=''
      if ((${+_zalias_dir_state[${key}]})); then
        _zalias_dir_scope "${key}"
        mark=" [dir: ${REPLY}]"
      fi
      print -r -- "${key#g:}: $_zalias_descriptions[${key}]${mark}"
    done
    for dkey in "${(@ko)_zalias_dir_defs}"; do
      _zalias_dir_key_split "${dkey}"
      _zalias_record_unpack _zalias_dir_fields "${_zalias_dir_defs[(e)${dkey}]}"
      [[ -n "${rec[description]}" ]] && ((! ${+_zalias_dir_state[${reply[2]}]})) \
        && print -r -- "${reply[2]}: ${rec[description]} [dir: ${reply[1]}]"
    done
    for key in "${(@ko)_zalias_function_descs}"; do
      print -r -- "${key}: $_zalias_function_descs[${key}]"
    done
    return
  fi

  if [[ -z "${NO_COLOR-}" ]]; then
    cyan=$'\e[1;36m' dim=$'\e[2m' reset=$'\e[0m'
  fi

  for key in "${(@k)_zalias_descriptions}" "${(@k)_zalias_function_descs}"; do
    name="${key#g:}"
    ((${#name} > width)) && width=${#name}
  done

  lines=("${cyan}Alias cheatsheet${reset}" '')
  for key in "${(@ko)_zalias_descriptions}"; do
    name="${key#g:}"
    if [[ "${key}" == g:* ]]; then
      definition="${galiases[${name}]-}"
    else
      definition="${aliases[${name}]-}"
    fi
    mark=''
    if ((${+_zalias_dir_state[${key}]})); then
      _zalias_dir_scope "${key}"
      mark=" [dir: ${REPLY}]"
    fi
    printf -v row '%s%-*s%s  %s%s' "${cyan}" "${width}" "${name}" "${reset}" "$_zalias_descriptions[${key}]" "${mark}"
    lines+=("${row}" "${dim}  ${definition}${reset}" '')
  done
  for dkey in "${(@ko)_zalias_dir_defs}"; do
    _zalias_dir_key_split "${dkey}"
    _zalias_record_unpack _zalias_dir_fields "${_zalias_dir_defs[(e)${dkey}]}"
    [[ -n "${rec[description]}" ]] && ((! ${+_zalias_dir_state[${reply[2]}]})) || continue
    printf -v row '%s%-*s%s  %s [dir: %s]' "${cyan}" "${width}" "${reply[2]}" "${reset}" "${rec[description]}" "${reply[1]}"
    lines+=("${row}" "${dim}  ${rec[value]}${reset}" '')
  done

  lines+=("${cyan}Function cheatsheet${reset}" '')
  for key in "${(@ko)_zalias_function_descs}"; do
    printf -v row '%s%-*s%s  %s' "${cyan}" "${width}" "${key}" "${reset}" "$_zalias_function_descs[${key}]"
    lines+=("${row}")
  done

  if [[ -n "${TMUX-}" && -t 0 ]] && ((${+commands[tmux]} && ${+commands[less]})); then
    file="$(mktemp "${TMPDIR:-/tmp}/zalias.XXXXXXXX")" || return 1
    {
      print -rl -- "$lines[@]" > "${file}" || return 1
      command tmux display-popup -E -w '90%' -h '85%' -T 'Aliases - q to close' \
        "${(q)commands[less]} -R -S -- ${(q)file}" && return 0
    } always {
      command rm -f -- "${file}"
    }
  fi

  print -rl -- "$lines[@]"
}
